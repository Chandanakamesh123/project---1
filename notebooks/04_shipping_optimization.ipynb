from pulp import *

# Create Optimization Problem
problem = LpProblem("Shipping_Optimization", LpMinimize)

# Decision Variables
x = LpVariable("shipment_units", lowBound=0)

# Objective Function
problem += 2500 * x

# Constraints
problem += x <= 100

# Solve Problem
problem.solve()

# Output Results
print("Optimization Status:", LpStatus[problem.status])

print("Optimized Shipment Units:", value(x))

print("Minimum Shipping Cost:", value(problem.objective))
