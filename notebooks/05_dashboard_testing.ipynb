import pandas as pd
import plotly.express as px

# Load Dataset
df = pd.read_csv("data/processed_shipping_data.csv")

# Demand Forecast Graph
fig1 = px.bar(
    df,
    x='factory_id',
    y='demand',
    title='Factory-wise Demand Forecast'
)

fig1.show()

# Shipping Cost Graph
fig2 = px.line(
    df,
    x='order_id',
    y='shipping_cost',
    title='Shipping Cost Analysis'
)

fig2.show()

# Factory Utilization Graph
fig3 = px.pie(
    df,
    names='factory_id',
    values='factory_capacity',
    title='Factory Utilization'
)

fig3.show()

print("Dashboard testing completed successfully.")
