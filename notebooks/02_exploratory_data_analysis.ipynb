import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load Dataset
df = pd.read_csv("data/processed_shipping_data.csv")

# Dataset Summary
print(df.describe())

# Shipping Cost Distribution
plt.figure(figsize=(8,5))
plt.hist(df['shipping_cost'])
plt.title("Shipping Cost Distribution")
plt.xlabel("Shipping Cost")
plt.ylabel("Frequency")
plt.show()

# Demand Analysis
plt.figure(figsize=(8,5))
sns.barplot(x='season', y='demand', data=df)
plt.title("Season-wise Demand Analysis")
plt.show()

# Factory Capacity Analysis
plt.figure(figsize=(8,5))
sns.boxplot(x='factory_id', y='factory_capacity', data=df)
plt.title("Factory Capacity Analysis")
plt.show()

# Correlation Heatmap
plt.figure(figsize=(12,8))
sns.heatmap(df.corr(), annot=True)
plt.title("Correlation Heatmap")
plt.show()

# Route Distance Analysis
plt.figure(figsize=(8,5))
plt.plot(df['route_distance'])
plt.title("Route Distance Analysis")
plt.xlabel("Orders")
plt.ylabel("Distance")
plt.show()

print("EDA completed successfully.")
